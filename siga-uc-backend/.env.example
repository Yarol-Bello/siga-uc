# ============================================================
# CONFIGURACIÓN DEL SERVIDOR
# ============================================================
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:4200

# ============================================================
# CONFIGURACIÓN DE POSTGRESQL
# ============================================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CAMBIAR_POR_TU_PASSWORD_DE_POSTGRES
DB_NAME=siga_uc

# ============================================================
# CONFIGURACIÓN JWT
# ============================================================
JWT_SECRET=CAMBIAR_POR_UNA_CLAVE_LARGA_Y_SEGURA
JWT_EXPIRES_IN=8h

# ============================================================
# CONFIGURACIÓN DE CORREO (SMTP) — OPCIONAL
# ============================================================
# Si no configuras esto, el sistema funciona igual:
# las notificaciones se guardan en BD pero NO se envían correos reales.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_app_password_de_16_caracteres
SMTP_FROM_NAME=SIGA-UC - I.E.P. Unión Científica

# ============================================================
# CONFIGURACIÓN GENERAL
# ============================================================
APP_NAME=SIGA-UC
APP_VERSION=1.0.0
TZ=America/Lima