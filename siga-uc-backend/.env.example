# ============================================================
# CONFIGURACIÓN DEL SERVIDOR
# ============================================================
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:4200

# ============================================================
# CONFIGURACIÓN DE POSTGRESQL
# ============================================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CAMBIAR_POR_TU_PASSWORD_DE_POSTGRES
DB_NAME=siga_uc

# Opcional. Si DATABASE_URL está definido, el API y el backup lo usan con
# prioridad sobre DB_*.
# Ejemplo: postgresql://usuario:password@host:5432/siga_uc?sslmode=require
DATABASE_URL=
# true si el proveedor exige SSL (Supabase normalmente sí).
DB_SSL=false

# Pool de conexiones (opcional; estos son los valores por defecto).
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
# Opcional: carpeta de salida de backups. Por defecto: siga-uc-backend/backups
BACKUP_DIR=

# ============================================================
# CONFIGURACIÓN JWT
# ============================================================
JWT_SECRET=CAMBIAR_POR_UNA_CLAVE_LARGA_Y_SEGURA
JWT_EXPIRES_IN=8h

# ============================================================
# CONFIGURACIÓN DE CORREO (RESEND) — OPCIONAL
# ============================================================
# El correo real usa Resend (API HTTP), no SMTP.
# En modo prueba, onboarding@resend.dev solo entrega a la cuenta dueña
# de Resend. Si no configuras RESEND_API_KEY, el sistema funciona igual:
# las notificaciones se guardan en BD y se ven en la campanita.
RESEND_API_KEY=
EMAIL_FROM=SIGA-UC <onboarding@resend.dev>

# ============================================================
# CONFIGURACIÓN ACADÉMICA
# ============================================================
ANIO_LECTIVO=2026

# Horarios (H47): horas por carga si horas_asignadas es NULL y
# máximo de bloques del mismo curso por día.
HORAS_DEFAULT_CARGA=2
MAX_BLOQUES_CURSO_DIA=2

# ============================================================
# PRIMERA CONFIGURACIÓN (H79)
# ============================================================
# Token de un solo uso para /setup. En producción es obligatorio.
# En desarrollo, si se omite, el backend genera uno y lo imprime al
# arrancar mientras el sistema no tenga administrador.
SETUP_TOKEN=

# ============================================================
# CONFIGURACIÓN GENERAL
# ============================================================
APP_NAME=SIGA-UC
APP_VERSION=1.0.0
TZ=America/Lima